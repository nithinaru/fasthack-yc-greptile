GREPTILE_API_KEY=        # app.greptile.com
GITHUB_TOKEN=             # fine-grained PAT, public-repo read (also sent to Greptile as X-GitHub-Token)
STRIPE_SECRET_KEY=        # TEST mode
STRIPE_WEBHOOK_SECRET=    # from `stripe listen` or dashboard endpoint (Modal /serve URL registered there)
MODAL_SCRIPT_URL=         # filled after `make publish` — see ENDPOINTS.md
MODAL_TTS_URL=            # filled after `make publish`
MODAL_SERVE_URL=          # filled after `make publish`
MODAL_VOLUME=repo-radio-data
CLAUDE_MEM_URL=http://localhost:37777
USE_MOCKS=1               # flip to 0 per-integration as they go live
SITE_URL=http://localhost:8080
