{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "repo-radio/episode.schema.json",
  "title": "Repo Radio episode (episodes/ep-NNN.json)",
  "type": "object",
  "required": ["id", "date", "repo", "title", "verdict", "audio", "segments"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "pattern": "^ep-\\d{3}$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "repo": {
      "type": "object",
      "required": ["full_name", "url", "language", "stars_at_airtime", "velocity_per_hr"],
      "properties": {
        "full_name": { "type": "string" },
        "url": { "type": "string" },
        "language": { "type": "string" },
        "stars_at_airtime": { "type": "integer" },
        "velocity_per_hr": { "type": "number" }
      }
    },
    "title": { "type": "string" },
    "verdict": { "type": "string", "enum": ["HYPE", "REAL", "MIXED"] },
    "audio": {
      "type": "object",
      "required": ["url", "duration_s", "peaks"],
      "properties": {
        "url": { "type": "string" },
        "duration_s": { "type": "number" },
        "peaks": { "type": "array", "items": { "type": "number" } }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/segment" }
    },
    "memory_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["episode_id", "note"],
        "properties": {
          "episode_id": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "qa_segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "audio_url", "segments"],
        "properties": {
          "question": { "type": "string" },
          "audio_url": { "type": "string" },
          "segments": { "type": "array", "items": { "$ref": "#/definitions/segment" } }
        }
      }
    }
  },
  "definitions": {
    "segment": {
      "type": "object",
      "required": ["i", "start", "end", "text", "citation"],
      "properties": {
        "i": { "type": "integer", "minimum": 0 },
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 },
        "text": { "type": "string" },
        "citation": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["file", "start_line", "end_line", "code_html"],
              "properties": {
                "file": { "type": "string" },
                "start_line": { "type": "integer", "minimum": 1 },
                "end_line": { "type": "integer", "minimum": 1 },
                "code_html": { "type": "string" }
              }
            }
          ]
        }
      }
    }
  }
}
